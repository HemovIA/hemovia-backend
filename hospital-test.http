@baseUrl = http://localhost:8080/api/v1

# Configure identifier e password em http-client.private.env.json.
# Execute o login e o GET /auth/csrf antes das escritas. O IntelliJ guarda os cookies da sessão.

### Entrar no sistema
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "identifier": "{{identifier}}",
  "password": "{{password}}"
}

### Obter o token CSRF
GET {{baseUrl}}/auth/csrf

> {%
    const cookie = response.headers.valuesOf("Set-Cookie")
        .find(value => value.startsWith("XSRF-TOKEN="));
    if (cookie) client.global.set("csrf", cookie.split(";")[0].slice("XSRF-TOKEN=".length));
%}

### Cadastro válido de hospital
POST {{baseUrl}}/hospitals
Content-Type: application/json
X-XSRF-TOKEN: {{csrf}}
{
  "name": "Hospital Central",
  "city": "Recife",
  "latitude": -8.05,
  "longitude": -34.88,
  "priority": 1
}

### Cadastro inválido de hospital - latitude fora do limite
POST {{baseUrl}}/hospitals
Content-Type: application/json
X-XSRF-TOKEN: {{csrf}}
{
  "name": "Hospital Teste Invalido",
  "city": "Recife",
  "latitude": 105,
  "longitude": -34.88,
  "priority": 1
}
