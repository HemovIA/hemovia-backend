# Copie para .env e troque os valores. O .env está no .gitignore e nunca vai para o repositório.

# Banco de dados
POSTGRES_DB=hemovia
POSTGRES_USER=hemovia
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# API
API_PORT=8080
HEMOVIA_API_DOCS_ENABLED=true
# Apenas para desenvolvimento local em HTTP
COOKIE_SECURE=false
# Primeiro administrador (preencha os quatro campos para habilitar o bootstrap)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_CPF=
ADMIN_PASSWORD=
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres

# pgAdmin (opcional, profile "tools")
PGADMIN_DEFAULT_EMAIL=admin@hemovia.local
PGADMIN_DEFAULT_PASSWORD=troque-esta-senha

# Serviço de rotas (OSRM)
ROUTING_BASE_URL=https://router.project-osrm.org
ROUTING_CONNECT_TIMEOUT=5s
ROUTING_REQUEST_TIMEOUT=15s
ROUTING_MINIMUM_INTERVAL=1s
ROUTING_PLATELETS_MAX_SECONDS=3600

# Confirmação de cadastro público por e-mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
REGISTRATION_EMAIL_FROM=
REGISTRATION_FRONTEND_URL=http://localhost:5173/
