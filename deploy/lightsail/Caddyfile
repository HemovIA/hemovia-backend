{
	default_sni {$HEMOVIA_PUBLIC_IP}
}

{$HEMOVIA_PUBLIC_IP} {
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			profile shortlived
		}
	}
	encode zstd gzip

	redir /grafana /grafana/ 308
	handle /grafana/* {
		header X-Robots-Tag "noindex, nofollow"
		@privateGrafana path /grafana/admin /grafana/admin/* /grafana/api/admin /grafana/api/admin/* /grafana/api/orgs /grafana/api/orgs/* /grafana/public-dashboards /grafana/public-dashboards/* /grafana/api/public/dashboards /grafana/api/public/dashboards/*
		handle @privateGrafana {
			respond 404
		}
		handle {
			reverse_proxy grafana:3000
		}
	}

	handle /api/* {
		reverse_proxy api:8080
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
