# Demonstração local: copie para .env e substitua os valores.
POSTGRES_DB=hemovia
POSTGRES_USER=hemovia
POSTGRES_PASSWORD=
JWT_SECRET=
GRAFANA_ADMIN_USER=hemovia-admin
GRAFANA_ADMIN_PASSWORD=
# Preencha os quatro campos para criar o administrador e executar a carga.
ADMIN_NAME=
ADMIN_CPF=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Conta criada com papel Viewer no Grafana. Usada pelos testes da entrega.
GRAFANA_VIEWER_USER=professor
GRAFANA_VIEWER_PASSWORD=

# Confirmação de cadastro público por e-mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
REGISTRATION_EMAIL_FROM=
REGISTRATION_FRONTEND_URL=http://localhost:5173/
