{
  "testCommand": "node scripts/spec-java/verify-tests.mjs",
  "reporter": "tap",
  "testGlobs": [
    "test/**",
    "tests/**",
    "src/**/*.test.*",
    "src/**/*.spec.*",
    "__tests__/**",
    "api/src/test/java/**/*.java"
  ],
  "srcGlobs": [
    "src/**",
    "scripts/spec-java/*.mjs",
    "api/src/main/java/com/hemovia/api/model/**/*.java",
    "api/src/main/java/com/hemovia/api/repository/**/*.java",
    "api/src/main/java/com/hemovia/api/service/implementation/**/*.java",
    "api/src/main/java/com/hemovia/api/controller/**/*.java",
    "api/src/main/java/com/hemovia/api/exceptions/GlobalExceptionHandler.java",
    "api/src/main/resources/db/migration/*.sql"
  ]
}
